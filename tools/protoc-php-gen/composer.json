{
    "name": "app/protoc-php-gen",
    "description": "Protoc plugin for generating PHP endpoints from protobuf services",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "ProtoPhpGen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "google/protobuf": "^5.34",
        "nette/php-generator": "^4.0",
        "typhoon/type": "^0.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "bin": [
        "bin/protoc-php-gen.php"
    ]
}
