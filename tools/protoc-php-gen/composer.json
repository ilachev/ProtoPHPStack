{
    "name": "app/protoc-php-gen",
    "description": "Protoc plugin for generating PHP transport contracts from protobuf services",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "ProtoPhpGen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "google/protobuf": "^3.0",
        "nette/php-generator": "^4.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^10.0"
    },
    "scripts": {
        "cs": "PHP_CS_FIXER_IGNORE_ENV=true php-cs-fixer fix --dry-run",
        "cs-fix": "PHP_CS_FIXER_IGNORE_ENV=true php-cs-fixer fix",
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "bin": [
        "bin/protoc-php-gen.php"
    ]
}
