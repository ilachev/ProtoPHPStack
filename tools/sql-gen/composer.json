{
    "name": "app/sql-gen",
    "description": "SQL-to-PHP code generator for the base API template",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "SqlGen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "nette/php-generator": "^4.0",
        "typhoon/type": "^0.6"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "cs": "php-cs-fixer fix --dry-run",
        "cs-fix": "php-cs-fixer fix",
        "phpstan": "phpstan analyse --no-progress --memory-limit=256M",
        "test": "phpunit",
        "check": [
            "@cs",
            "@phpstan",
            "@test"
        ]
    },
    "bin": [
        "bin/sql-gen.php",
        "bin/sql-check.php",
        "bin/sql-check-pg.php"
    ]
}
