{
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ip2location/ip2location-php": "^9.8.1",
        "nyholm/psr7": "^1.8",
        "spiral/roadrunner-http": "^4.1",
        "spiral/roadrunner-kv": "^4.3.1",
        "spiral/roadrunner-worker": "^3.6.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.94",
        "nette/php-generator": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": ["src/", "protos/gen/App/"],
            "App\\Generated\\": "gen/Generated/",
            "Google\\Api\\": "protos/gen/Google/Api/",
            "GPBMetadata\\Google\\Api\\": "protos/gen/GPBMetadata/Google/Api/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "ProtoPhpGen\\": "tools/protoc-php-gen/src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
